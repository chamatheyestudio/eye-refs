#!/bin/bash
# Runs before Eye Refs installs: close any open copy and remove the old app.
# Your boards, unsaved boards, settings and sign in are all kept.
pkill -x "Eye Refs" 2>/dev/null
sleep 1
pkill -9 -x "Eye Refs" 2>/dev/null
rm -rf "/Applications/Eye Refs.app"
USER_NAME=$(stat -f%Su /dev/console 2>/dev/null)
if [ -n "$USER_NAME" ] && [ "$USER_NAME" != "root" ]; then
  HOME_DIR=$(dscl . -read "/Users/$USER_NAME" NFSHomeDirectory 2>/dev/null | awk '{print $2}')
  if [ -n "$HOME_DIR" ]; then
    rm -rf "$HOME_DIR/Applications/Eye Refs.app"
    rm -rf "$HOME_DIR/Library/Caches/ae.eyestudio.eyerefs" "$HOME_DIR/Library/Saved Application State/ae.eyestudio.eyerefs.savedState"
  fi
fi
exit 0
